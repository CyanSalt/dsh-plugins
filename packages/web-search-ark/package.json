{
  "name": "@cyansalt/dsh-web-search-ark",
  "version": "0.1.0-0",
  "description": "Ark web search provider for DeepSeek Harness",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "dist",
    "locale"
  ],
  "scripts": {
    "prepack": "tsdown"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "CyanSalt",
  "license": "ISC",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.3",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-web": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-agent-default-model": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-launch-environment": "catalog:",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@deepseek-ai/dsh-web": "catalog:"
  }
}
