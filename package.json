    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "ignore"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@lerna-lite/cli": "^5.6.2",
    "@lerna-lite/publish": "^5.6.2",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
