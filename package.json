{
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --fix './**/*.{js,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,ts}'",
    "release": "lerna publish --stage --yes"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
